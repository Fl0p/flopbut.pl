# Local secrets for `wrangler dev`. Copy to .dev.vars (git-ignored) and fill in.
# For production use `wrangler secret put <NAME>` — never commit real values.
#
# The contact endpoint stays dormant (503) until all three are present.

# Turnstile — https://dash.cloudflare.com → Turnstile → add site, free, unlimited.
# The site key is public and goes in the form markup; only the secret belongs here.
TURNSTILE_SECRET=

# Telegram delivery — create a bot via @BotFather, then get the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the bot once.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
