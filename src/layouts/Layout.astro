---
import { Font } from 'astro:assets';
import { type Locale, SITE_URL } from '../config.ts';
import { alternateLinks, useTranslations } from '../i18n/utils.ts';
import '../styles/global.css';

interface Props {
  locale: Locale;
  /** Error pages: skip indexing and skip hreflang, which would advertise routes that do not exist. */
  noIndex?: boolean;
}

const { locale, noIndex = false } = Astro.props;
const t = useTranslations(locale);
const alternates = noIndex ? [] : alternateLinks(locale, Astro.url);
const canonical = new URL(Astro.url.pathname, SITE_URL);

/*
  Preload only what paints first, in the alphabet this page is actually written in:
  the display face for the name and the body face for running text. Preloading whole
  families pulled in every weight and subset - 18 files and 185 KB on every page.
*/
const fontSubset = locale === 'ru' ? 'cyrillic' : 'latin';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical.href} />

    {
      alternates.map(({ locale: alt, path }) => (
        <link rel="alternate" hreflang={alt} href={new URL(path, SITE_URL).href} />
      ))
    }
    {!noIndex && <link rel="alternate" hreflang="x-default" href={new URL('/', SITE_URL).href} />}
    {noIndex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={locale} />
    {/* Square portrait, so the small card is the right shape for it. */}
    <meta property="og:image" content={new URL('/og.jpg', SITE_URL).href} />
    <meta property="og:image:width" content="600" />
    <meta property="og:image:height" content="600" />
    <meta property="og:image:alt" content="Flop Butylkin" />
    <meta name="twitter:card" content="summary" />

    <meta name="theme-color" content="#0b1312" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#eef0ea" media="(prefers-color-scheme: light)" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* The SVG carries both treatments and swaps them on the browser theme. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <Font cssVariable="--font-display" preload={[{ weight: 700, subset: fontSubset }]} />
    <Font cssVariable="--font-body" preload={[{ weight: 400, subset: fontSubset }]} />
    <Font cssVariable="--font-mono" />

    {/* Applies the stored theme before first paint so the page never flashes. */}
    <script is:inline>
      try {
        if (localStorage.getItem('theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
        }
      } catch {
        /* private mode - the dark default is fine */
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">{t.nav.skipToContent}</a>
    <slot />
  </body>
</html>
