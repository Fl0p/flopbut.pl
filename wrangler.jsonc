{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flopbut-pl",

  // Unified Astro entrypoint. Static pages are served straight from assets;
  // this worker only runs for routes that opted out of prerendering.
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],

  // The adapter splits its output: prerendered pages into dist/client, the worker into
  // dist/server. After `astro build` wrangler follows the generated dist/client/wrangler.json
  // rather than this file, so treat the path below as documentation of the same layout.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Kept on as a fallback while the apex settles; safe to set false afterwards.
  "workers_dev": true,

  // A plain route rather than `custom_domain`: the apex still carries leftover A records,
  // and Cloudflare refuses to attach a custom domain over externally managed DNS. Those
  // records are proxied, so the worker intercepts the request before any origin is reached.
  // Deleting them and switching to custom_domain is the tidier end state.
  // www is included because its CNAME resolves to the apex, whose leftover A records are
  // dead; without its own route it would 522. The canonical tag points at the apex, so
  // serving both hostnames does not create a duplicate in search results.
  "routes": [
    { "pattern": "flopbut.pl/*", "zone_name": "flopbut.pl" },
    { "pattern": "www.flopbut.pl/*", "zone_name": "flopbut.pl" }
  ]
}
